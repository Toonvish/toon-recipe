# ---------------------------------------------------------------------------
# toon-recipe environment
# Copy to .env and fill in. The API validates all of this at boot (src/env.ts)
# and fails fast with a readable message.
# ---------------------------------------------------------------------------

# --- Database (Turso / libSQL) ---------------------------------------------
# Self-hosted / local file DB:
DATABASE_URL="file:./data/local.db"
# Turso cloud instead:
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# Only required for remote libsql:// / https:// URLs. Leave empty for file: DBs.
DATABASE_AUTH_TOKEN=""

# --- API server -------------------------------------------------------------
# Port the Hono/Bun.serve API listens on.
API_PORT="3001"
# Exact origin of the web app, used for CORS (credentials: true). Comma-separated
# list allowed for multiple origins (e.g. dev + LAN IP for phone testing).
WEB_ORIGIN="http://localhost:5173"
# 32+ char random secret used to sign/derive short-lived cookies (OAuth state, PKCE).
# Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32-byte-random-hex-string-0000000"
# "development" | "production" | "test". Controls Secure cookie flag + error verbosity.
NODE_ENV="development"
# Set to 1 ONLY when a reverse proxy (nginx/Caddy/Traefik/Cloudflare) sits in front of
# the API and OVERWRITES X-Forwarded-For. Otherwise the rate limiter uses the socket
# address, because a client-supplied header would let anyone reset their own login /
# registration bucket by sending a new value on every request.
TRUST_PROXY=""

# --- Web app (Vite, must be inlined at build time) --------------------------
# Base URL of the API as seen from the browser. No trailing slash.
# LEAVE THIS EMPTY for a same-origin deployment (that is what the Docker image
# does): the client then uses relative URLs like "/api/recipes", so one build works
# behind any hostname. An absolute value here is baked into the bundle.
PUBLIC_API_URL="http://localhost:3001"

# --- Serving the web app from the API --------------------------------------
# Directory of the built PWA. When set, the API serves it from its OWN port, which
# is how the container runs: one origin, no CORS, no second web server. Relative
# paths resolve from the repo root. Leave empty in development — vite serves it.
#   Docker:      /app/apps/web/dist   (already set in the image)
#   Locally:     ./apps/web/dist      (after `bun run build`, then open :3001)
WEB_DIST_DIR=""

# --- OAuth ------------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID
#   (Web application). Authorized redirect URI:
#   ${OAUTH_REDIRECT_BASE}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers -> New OAuth App. Callback URL:
#   ${OAUTH_REDIRECT_BASE}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Public base URL of the API used to build OAuth redirect URIs. No trailing slash.
OAUTH_REDIRECT_BASE="http://localhost:3001"

# --- Uploads & OCR ----------------------------------------------------------
# Directory for uploaded images/PDFs. Relative paths resolve from the repo root.
UPLOAD_DIR="./data/uploads"
# FEATURE FLAG: import from a PHOTO or a PDF. OFF unless set to 1/true.
#
# Leaving it off is what lets the app run on a small VPS: URL and text import are
# pure fetch-and-parse, while OCR needs the `tesseract` and `pdftoppm` binaries
# (~120 MB with language data) and holds sharp/unpdf plus a decoded bitmap in
# memory for every job. With it off, /imports/{image,pdf,file} answer 501
# `ocr_disabled` and the web UI does not offer them at all.
#
# The Docker image only contains the binaries when built with
# `--build-arg WITH_OCR=1`, and defaults this variable to match.
IMPORT_OCR_ENABLED=""
# Tesseract languages, "+"-separated. German first (source sites are German).
# OCR shells out to the NATIVE `tesseract` binary, so each language needs its OS
# package installed — `deu` here means `tesseract-ocr-deu` on the host. Nothing is
# downloaded at runtime. Dropping this to just "deu" is the cheapest way to make
# imports faster and lighter if you never scan English recipes.
TESSERACT_LANGS="deu+eng"
# Both native binaries the import pipeline spawns. Only set these if they are not
# on PATH (macOS/Homebrew, Nix). Install on Debian/Ubuntu with:
#   sudo apt install tesseract-ocr tesseract-ocr-deu tesseract-ocr-eng poppler-utils
#TESSERACT_BIN="tesseract"
#PDFTOPPM_BIN="pdftoppm"
# DEVELOPMENT ONLY: set to 1 to let the URL importer fetch localhost / private IPs
# (e.g. a fixture served on 127.0.0.1). The SSRF guard is otherwise strict.
# Ignored when NODE_ENV=production. Leave empty unless you are testing locally.
IMPORT_ALLOW_PRIVATE_HOSTS=""

# --- Mail -------------------------------------------------------------------
# ALL OPTIONAL. Leave MAIL_TRANSPORT empty (or "console") and the API logs every mail
# — invite, Passwort-vergessen, E-Mail-Bestätigung — including the link, and sends
# nothing. `bun run dev` and `bun test` then never touch the network, and a
# self-hosted install without mail still boots and works:
#   * invite links are returned by the API and can be forwarded by hand,
#   * a locked-out user is unlocked with `bun run auth:reset-password <email>`.
#
# "console" (default) | "smtp" | "resend"
MAIL_TRANSPORT=""
# Sender, "Name <adresse>" or a bare address. REQUIRED for a real transport. For a
# real relay the domain has to be verified with the provider or every mail bounces;
# with the local Mailpit it can be anything, because nothing leaves the machine.
MAIL_FROM=""

# --- Mail via SMTP (the self-hosted transport, NO API key) -------------------
# This is what the Docker stack uses: MAIL_HOST="mailpit" on the private compose
# network, which accepts every message and shows it in a web UI. Point the same
# settings at a real relay and nothing else changes.
# REQUIRED when MAIL_TRANSPORT="smtp". In the container stack: "mailpit".
MAIL_HOST=""
# Defaults to 465 for MAIL_SECURITY="tls", otherwise 587. Mailpit listens on 1025.
MAIL_PORT=""
# Leave BOTH empty for a relay that does not authenticate (Mailpit).
MAIL_USER=""
MAIL_PASSWORD=""
# "starttls" (default) plaintext greeting then a MANDATORY TLS upgrade, port 587
# "tls"                TLS from the first byte, port 465
# "none"               plaintext for the whole session. Only defensible for a relay
#                      on the same private network — which is exactly Mailpit's
#                      case, and it needs no login. The API REFUSES TO START if you
#                      combine "none" with MAIL_USER, because those credentials
#                      would go over the wire in the clear.
MAIL_SECURITY=""
# Set to 1 to accept a self-signed certificate from your relay. Off unless needed.
MAIL_TLS_INSECURE=""

# --- Mail via Resend (third party, needs an account) ------------------------
# Resend API key (re_...). REQUIRED when MAIL_TRANSPORT="resend".
# Get one at https://resend.com -> API Keys, after verifying your sending domain.
# The API refuses to start if this is missing while MAIL_TRANSPORT="resend", rather
# than looking healthy and silently delivering nothing.
MAIL_API_KEY=""

# --- Tests ------------------------------------------------------------------
# `bun test` always uses an in-memory libSQL DB (NODE_ENV=test forces
# DATABASE_URL="file::memory:"). Set this only if a test needs a real file DB.
TEST_DATABASE_URL=""
