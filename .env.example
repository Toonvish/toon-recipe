# ---------------------------------------------------------------------------
# toon-recipe environment
# Copy to .env and fill in. The API validates all of this at boot (src/env.ts)
# and fails fast with a readable message.
# ---------------------------------------------------------------------------

# --- Database (Turso / libSQL) ---------------------------------------------
# Self-hosted / local file DB:
DATABASE_URL="file:./data/local.db"
# Turso cloud instead:
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# Only required for remote libsql:// / https:// URLs. Leave empty for file: DBs.
DATABASE_AUTH_TOKEN=""

# --- API server -------------------------------------------------------------
# Port the Hono/Bun.serve API listens on.
API_PORT="3001"
# Exact origin of the web app, used for CORS (credentials: true). Comma-separated
# list allowed for multiple origins (e.g. dev + LAN IP for phone testing).
WEB_ORIGIN="http://localhost:5173"
# 32+ char random secret used to sign/derive short-lived cookies (OAuth state, PKCE).
# Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32-byte-random-hex-string-0000000"
# "development" | "production" | "test". Controls Secure cookie flag + error verbosity.
NODE_ENV="development"
# Set to 1 ONLY when a reverse proxy (nginx/Caddy/Traefik/Cloudflare) sits in front of
# the API and OVERWRITES X-Forwarded-For. Otherwise the rate limiter uses the socket
# address, because a client-supplied header would let anyone reset their own login /
# registration bucket by sending a new value on every request.
TRUST_PROXY=""

# --- Web app (Vite, must be inlined at build time) --------------------------
# Base URL of the API as seen from the browser. No trailing slash.
PUBLIC_API_URL="http://localhost:3001"

# --- OAuth ------------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID
#   (Web application). Authorized redirect URI:
#   ${OAUTH_REDIRECT_BASE}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers -> New OAuth App. Callback URL:
#   ${OAUTH_REDIRECT_BASE}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Public base URL of the API used to build OAuth redirect URIs. No trailing slash.
OAUTH_REDIRECT_BASE="http://localhost:3001"

# --- Uploads & OCR ----------------------------------------------------------
# Directory for uploaded images/PDFs. Relative paths resolve from the repo root.
UPLOAD_DIR="./data/uploads"
# tesseract.js language packs, "+"-separated. German first (source sites are German).
# The packs (~15 MB for deu+eng) are downloaded ONCE into ./data/tessdata. Run
# `bun run ocr:prefetch` at deploy time, or pre-seed *.traineddata there, if the host
# has no outbound HTTPS — the first import would otherwise fail with ocr_failed.
TESSERACT_LANGS="deu+eng"
# DEVELOPMENT ONLY: set to 1 to let the URL importer fetch localhost / private IPs
# (e.g. a fixture served on 127.0.0.1). The SSRF guard is otherwise strict.
# Ignored when NODE_ENV=production. Leave empty unless you are testing locally.
IMPORT_ALLOW_PRIVATE_HOSTS=""

# --- Tests ------------------------------------------------------------------
# `bun test` always uses an in-memory libSQL DB (NODE_ENV=test forces
# DATABASE_URL="file::memory:"). Set this only if a test needs a real file DB.
TEST_DATABASE_URL=""
