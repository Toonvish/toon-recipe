# ---------------------------------------------------------------------------
# toon-recipe — Docker/Compose Umgebung
#
# Auf dem Raspberry Pi als `.env` NEBEN die docker-compose.yml legen:
#     cp docker/env.example .env && nano .env
#
# Nur die ersten drei Werte müssen gesetzt werden. Alles andere hat
# funktionierende Standardwerte — die vollständige Liste aller Variablen der
# Anwendung steht in /.env.example.
# ---------------------------------------------------------------------------

# --- PFLICHT ---------------------------------------------------------------

# Der Hostname, unter dem die App im Netz erreichbar ist. GENAU DIESER Name muss
# auf allen Geräten benutzt werden: Caddy stellt das Zertifikat pro Name aus, und
# ein Zugriff über die IP-Adresse erzeugt eine neue Warnung.
#
# Praktikable Varianten:
#   rezepte.fritz.box     -> FRITZ!Box: Hostname des Pi + ".fritz.box" (empfohlen)
#   rezepte.local         -> mDNS/Avahi, funktioniert auf iOS/macOS zuverlässig,
#                            unter Android nur eingeschränkt
#   rezepte.example.org   -> eigene Domain (dann später ein echtes Zertifikat)
TOON_HOSTNAME=rezepte.fritz.box

# 32-Byte-Zufallswert. Signiert die kurzlebigen OAuth-/PKCE-Cookies UND die
# Signaturen der /uploads-URLs.
#
#   openssl rand -hex 32
#
# ⚠ Wird dieser Wert später geändert, sind alle bereits ausgelieferten
#   Bild-URLs ungültig (die Bilder selbst bleiben erhalten).
SESSION_SECRET=

# Das zu startende Image. Der Deploy-Job aus GitHub Actions überschreibt diese
# Zeile mit dem konkreten Digest, damit ein spätereres `docker compose up -d`
# dieselbe Version startet und nicht auf `latest` zurückfällt.
TOON_IMAGE=ghcr.io/toonvish/toon-recipe:latest


# --- OPTIONAL --------------------------------------------------------------

# Absender der ausgehenden Mails. Mit Mailpit ist die Adresse beliebig — sie wird
# nirgends verifiziert, weil nichts das private Netz verlässt.
MAIL_FROM=Rezepte <rezepte@localhost>

# OCR-Sprachen, "+"-getrennt, Deutsch zuerst. Die Sprachpakete sind im Image
# bereits enthalten; eine weitere Sprache hier lädt beim ersten Import ~15 MB
# nach und braucht dann einmalig ausgehendes HTTPS.
TESSERACT_LANGS=deu+eng

# Speicherobergrenze des App-Containers. Ein Pi 4 mit 2 GB sollte hier nicht
# höher gehen: der Tesseract-Worker ist das einzige, was bei einem 12-MP-Foto
# unbegrenzt wachsen kann, und ohne Limit nimmt der OOM-Killer stattdessen den
# Docker-Daemon mit.
#   Pi 4 / 5 mit 2 GB  -> 1200m
#   Pi 4 / 5 mit 4 GB  -> 1500m  (Standard)
#   Pi 5 mit 8 GB      -> 3000m
TOON_MEM_LIMIT=1500m

# --- OAuth (bewusst leer) --------------------------------------------------
# E-Mail + Passwort ist der selbstgehostete Weg und braucht niemandes Server.
# Google/GitHub sind naturgemäß Dritte; nur ausfüllen, wenn das gewünscht ist.
# Redirect-URI beim Anbieter dann: https://${TOON_HOSTNAME}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
