# =============================================================================
# Caddy in front of toon-recipe.
#
# WHY THERE IS A PROXY AT ALL: the PWA needs a SECURE CONTEXT. Browsers refuse to
# register a service worker over plain http (localhost excepted), and without the
# service worker there is no install prompt and no offline shopping list — the one
# feature that is meant to work with the wifi off. So the app is served over TLS
# even on a LAN.
#
# CERTIFICATES: `tls internal` issues one from Caddy's OWN local CA, which needs no
# domain, no open ports and no Let's Encrypt account.
#
#   ⚠ A DEVICE THAT DOES NOT TRUST THAT CA GETS A WARNING **AND NO PWA**. Clicking
#     through the interstitial does NOT make the origin secure: the service worker
#     still refuses to register. Install the root certificate once per phone (it is
#     served at http://<host>/toon-root-ca.crt, see below, and the walkthrough is
#     in docs/deployment.md) and everything works exactly like a public site.
#
# TO SWITCH TO A REAL CERTIFICATE later, replace the `tls internal` line with
# nothing at all (Caddy then gets a Let's Encrypt cert automatically, given a
# public domain and reachable ports 80/443) or with `tls { dns <provider> ... }`
# for a DNS-01 challenge. Nothing else in this file changes.
# =============================================================================
{
	# No admin API: it is a full control plane over the proxy, and nothing here
	# needs it. Off by default is one less thing listening in the container.
	admin off
	# Local CA only — never contact an ACME server for `tls internal`.
	local_certs
}

# -----------------------------------------------------------------------------
# The app, over HTTPS.
# TOON_HOSTNAME comes from the compose .env (e.g. rezepte.fritz.box, or the Pi's
# hostname). Use the SAME name on every device — a certificate is issued per name,
# and reaching the Pi by IP when the cert says `rezepte.local` is a fresh warning.
# -----------------------------------------------------------------------------
{$TOON_HOSTNAME} {
	tls internal

	encode zstd gzip

	reverse_proxy app:3001 {
		# ------------------------------------------------------------------
		# KEEP THIS, EVEN THOUGH CADDY LOGS IT AS "UNNECESSARY".
		#
		# The app runs with TRUST_PROXY=1 behind this proxy, so it believes
		# X-Forwarded-For and uses the FIRST entry as the client address for
		# every rate-limit bucket (login, registration, password reset). A
		# client that can choose that value has no rate limit at all — a fresh
		# header per request is a fresh bucket per request. That is exactly the
		# bug apps/api/src/services/auth/rateLimit.ts documents.
		#
		# Measured behaviour of `curl -H "X-Forwarded-For: 1.2.3.4"`:
		#
		#   Caddy default ................ upstream sees the real peer  (safe)
		#   + trusted_proxies 0.0.0.0/0 ... upstream sees "1.2.3.4, <peer>"  (!)
		#   + this header_up ............. upstream sees the real peer  (safe)
		#
		# So Caddy's default is already correct and Caddy is right that the
		# line changes nothing TODAY — it is here for the second row. Adding a
		# `trusted_proxies` line (a common copy-paste when putting another
		# proxy or Cloudflare in front) silently re-opens the bypass, and this
		# overwrite is what keeps that from turning into an auth-bruteforcing
		# hole. Cost: one startup warning. Keep it.
		# ------------------------------------------------------------------
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}

		# Photo and PDF imports are large multipart uploads that then run OCR on a
		# Pi's CPU. The API's own cap is 15 MB; these keep the proxy from timing
		# the request out before the pipeline is done.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# The API is the only thing that may set the session cookie, and it does it
	# with HttpOnly/SameSite already. These are the headers a proxy can add that
	# the app cannot set for itself in a useful way.
	header {
		# NO Content-Security-Policy here on purpose. The app is same-origin end to
		# end, so a strict one would be cheap in principle — but vite inlines a
		# small bootstrap script, so a policy without the matching hash silently
		# turns the app into a blank page. Add one only together with a build that
		# emits the hashes, and test it on a phone before deploying.
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# HSTS is deliberately NOT set: with a private CA and a .local/.box name,
		# pinning HTTPS for a hostname you may later reuse is a good way to lock
		# yourself out of your own LAN. Add it once you have a real certificate.
		-Server
	}
}

# -----------------------------------------------------------------------------
# Plain HTTP: only the root certificate, everything else redirects.
#
# The CA certificate is served over http ON PURPOSE — a phone that does not trust
# the CA yet cannot fetch it over the HTTPS that this same CA signs without hitting
# the very warning we are trying to remove. What is published here is a PUBLIC
# certificate; the CA's private key never leaves the caddy_data volume.
# -----------------------------------------------------------------------------
http://{$TOON_HOSTNAME} {
	handle /toon-root-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=toon-root-ca.crt"
		file_server
	}

	handle {
		redir https://{host}{uri} permanent
	}
}
